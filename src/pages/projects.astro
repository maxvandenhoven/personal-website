---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PageHeading } from "../components/layout";
import { ProjectCard } from "../components/projects";
import { FilterableList } from "../components/ui";
import { getProjects, getSiteConfig } from "../lib/content";
import { collectTags } from "../lib/tags";
import { sectionIndex } from "../lib/navigation";

const site = await getSiteConfig();
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description={site.projects_page.description}
  currentPage="projects"
>
  <PageHeading
    id="projects-h"
    index={sectionIndex("projects")}
    title="Projects"
    lead={site.projects_page.lead}
  />
  <FilterableList
    label="Browse projects"
    tags={collectTags(projects)}
    total={projects.length}
    noun={{ singular: "project", plural: "projects" }}
    emptyMessage="No projects match this topic."
  >
    {projects.map((project) => <ProjectCard project={project} />)}
  </FilterableList>
</BaseLayout>
