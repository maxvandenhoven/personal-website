---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperSheet from "../components/layout/PaperSheet.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
---

<BaseLayout
  title="Projects — Max van den Hoven"
  description="Open-source tools and projects I build and maintain."
>
  <!-- The same black isometric sheet as the homepage's projects section.
       Intentionally empty beyond the header for now. -->
  <PaperSheet
    variant="projects"
    pattern="iso"
    layer={1}
    class="min-h-[calc(100vh-var(--nb-header-h))]"
  >
    <SectionHeader
      tone="light"
      title="Things I've built"
      subtitle="Open-source tools and projects I build and maintain. A few things worth pinning up are on their way."
    />
  </PaperSheet>
</BaseLayout>
