---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <div class="flex flex-col items-center justify-center px-8 py-32 text-center">
    <h1
      class="font-heading mb-4 text-[64px] leading-none font-bold tracking-[-0.04em]"
    >
      404
    </h1>
    <p class="text-text-secondary mb-8 text-base">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="btn-lift bg-accent-500 inline-flex items-center gap-1.5 rounded-md border-2 border-[#000] px-6 py-3 text-sm font-bold shadow-md"
    >
      Go back home
    </a>
  </div>
</BaseLayout>
