---
import { getEntry, getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperSheet from "../components/layout/PaperSheet.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { Polaroid } from "../components/ui/Polaroid";
import { NotebookButton } from "../components/ui/NotebookButton";
import { StickyNote } from "../components/ui/StickyNote";
import { TapedBlogCard } from "../components/blog/TapedBlogCard";
import headshot from "../../content/headshot.jpeg";

const homepageEntry = await getEntry("homepage", "config");
if (!homepageEntry) throw new Error("Homepage config not found");
const config = homepageEntry.data;

const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);

const allBlogs = await getCollection("blogs");

const featuredBlogs = config.featured_blogs
  .map((slug) =>
    allBlogs.find((b) => b.id === slug && b.data.status === "published"),
  )
  .filter(Boolean);

// Sticky notes and blog cards are cycled through small palettes / tilts so the
// stack looks hand-placed rather than uniform.
const stickyColors = [
  "var(--nb-sticky)",
  "var(--nb-sticky-2)",
  "var(--nb-sticky-3)",
];
const stickyTilts = ["-1.8deg", "1.4deg", "-0.8deg"];
const cardTilts = ["-1.2deg", "1deg", "-0.6deg"];

// Split the tagline around the highlighted word so we can wrap just that word
// in a highlighter marker. Falls back gracefully if the word isn't found.
const tagline = config.hero_tagline;
const highlight = config.hero_highlight;
const idx = tagline.toLowerCase().indexOf(highlight.toLowerCase());
const taglineBefore = idx >= 0 ? tagline.slice(0, idx) : tagline;
const taglineWord = idx >= 0 ? tagline.slice(idx, idx + highlight.length) : "";
const taglineAfter = idx >= 0 ? tagline.slice(idx + highlight.length) : "";
---

<BaseLayout title={config.name} description={config.hero_tagline}>
  <!-- Hero — beige ruled sheet with a red margin, torn edge overlapping the
       skills section below. Left: tagline + description + CTAs. Right: a
       pinned polaroid headshot. -->
  <PaperSheet variant="hero" pattern="ruled" margin torn fullHeight layer={4}>
    <div
      class="grid items-center gap-12 select-none md:grid-cols-[1.2fr_auto] md:gap-16"
    >
      <div>
        <h1 class="nb-h1 mb-[var(--nb-rule)] max-w-[16ch]">
          {taglineBefore}<span class="nb-mark">{taglineWord}</span>{
            taglineAfter
          }
        </h1>
        <p class="nb-lead mb-[var(--nb-rule)] max-w-[52ch]">
          {config.hero_description}
        </p>
        <div class="flex flex-wrap items-center gap-6">
          <NotebookButton href="#blog">Read the blog &rarr;</NotebookButton>
          <a href="#projects" class="nb-textlink">
            See projects
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div class="hidden justify-self-center md:block">
        <Polaroid
          src={headshot.src}
          alt={`Photo of ${config.name}`}
          signature={config.name}
          size={300}
        />
      </div>
    </div>
  </PaperSheet>

  <!-- Skills — white grid sheet, no margin. Sticky notes for each skill group.
       Torn edge overlaps the blog sheet below. -->
  <PaperSheet variant="skills" pattern="grid" torn layer={3}>
    <SectionHeader
      title={config.skills_title}
      subtitle={config.skills_description}
    />
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        config.skills.map((group, i) => (
          <StickyNote
            title={group.skill_title}
            items={group.entries}
            bg={stickyColors[i % stickyColors.length]}
            tilt={stickyTilts[i % stickyTilts.length]}
          />
        ))
      }
    </div>
  </PaperSheet>

  <!-- Blog — light-blue ruled sheet with its own (teal) margin. Taped cards for
       each featured post. Torn edge overlaps the projects sheet below. -->
  {
    featuredBlogs.length > 0 && (
      <PaperSheet
        id="blog"
        variant="blog"
        pattern="ruled"
        margin
        torn
        layer={2}
      >
        <SectionHeader
          title={config.blog_title}
          subtitle={config.blog_description}
        />
        <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {featuredBlogs.map((blog, i) => {
            const bannerKey = Object.keys(bannerImages).find((key) =>
              key.startsWith(`/content/blogs/${blog!.id}/banner.`),
            );
            return (
              <TapedBlogCard
                title={blog!.data.title}
                description={blog!.data.description}
                publishDate={blog!.data.publish_date}
                readingTime={blog!.data.reading_time}
                tags={blog!.data.tags}
                href={`/blog/${blog!.id}`}
                bannerSrc={
                  bannerKey ? bannerImages[bannerKey].default.src : undefined
                }
                tilt={cardTilts[i % cardTilts.length]}
              />
            );
          })}
        </div>
      </PaperSheet>
    )
  }

  <!-- Projects — black isometric sheet (the back of the stack, not torn).
       Intentionally left empty for now; header only. -->
  <PaperSheet id="projects" variant="projects" pattern="iso" layer={1}>
    <SectionHeader
      title={config.projects_title}
      subtitle={config.projects_description}
      tone="light"
    />
  </PaperSheet>
</BaseLayout>
