---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BlogCard } from "../components/blog";
import { AboutStory, Hero, SkillGrid, StudyPath } from "../components/home";
import { Section, SectionHeading } from "../components/layout";
import { ProjectCard } from "../components/projects";
import { CardGrid } from "../components/ui";
import {
  getHomepageConfig,
  getPosts,
  getProjects,
  getSiteConfig,
  getSkills,
  selectFeatured,
} from "../lib/content";
import { sectionIndex } from "../lib/navigation";
import headshot from "../../content/headshot.png";

const site = await getSiteConfig();
const home = await getHomepageConfig();
// homepage.yaml picks which skills, projects and posts to show, and in what order.
const skills = await selectFeatured(
  await getSkills(),
  home.about.skills,
  "skills",
);
const projects = await selectFeatured(
  await getProjects(),
  home.featured_projects.projects,
  "projects",
);
const posts = await selectFeatured(
  await getPosts(),
  home.featured_blogs.blogs,
  "blogs",
);

// The portrait is full width below 900px and roughly half the 1180px column above it.
const portrait = await getImage({
  src: headshot,
  widths: [400, 600, 800, 1200],
  format: "webp",
});
---

<BaseLayout
  description={site.description}
  currentPage="home"
  spacing="sections"
>
  <Hero
    title={home.hero.title}
    description={home.hero.description}
    socials={site.socials}
    portrait={{
      src: portrait.src,
      srcSet: portrait.srcSet.attribute,
      sizes: "(min-width: 900px) 560px, 100vw",
      width: headshot.width,
      height: headshot.height,
      alt: home.hero.portrait_alt,
    }}
  />

  <Section id="skills" aria-labelledby="skills-h">
    <SectionHeading
      id="skills-h"
      index={sectionIndex("about")}
      title={home.about.title}
    />
    <div class="gap-col-gap grid grid-cols-1 items-start md:grid-cols-2">
      <AboutStory lede={home.about.lede} paragraphs={home.about.paragraphs} />
      <StudyPath
        title={home.about.education.title}
        steps={home.about.education.steps}
      />
    </div>
    <SkillGrid skills={skills} />
  </Section>

  <Section id="work" aria-labelledby="work-h">
    <SectionHeading
      id="work-h"
      index={sectionIndex("projects")}
      title={home.featured_projects.title}
      action={{ href: "/projects", label: "All projects" }}
    />
    <CardGrid>
      {projects.map((project) => <ProjectCard project={project} />)}
    </CardGrid>
  </Section>

  <Section id="writing" aria-labelledby="writing-h">
    <SectionHeading
      id="writing-h"
      index={sectionIndex("blog")}
      title={home.featured_blogs.title}
      action={{ href: "/blog", label: "All articles" }}
    />
    <CardGrid>
      {posts.map((post) => <BlogCard post={post} />)}
    </CardGrid>
  </Section>
</BaseLayout>
