---
import { getEntry, getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BlogCard } from "../components/blog";

const homepageEntry = await getEntry("homepage", "config");
if (!homepageEntry) throw new Error("Homepage config not found");
const config = homepageEntry.data;

const allProjects = await getCollection("projects");
const allBlogs = await getCollection("blogs");

const featuredProjects = config.featured_projects
  .map((slug) =>
    allProjects.find((p) => p.id === slug && p.data.status === "published"),
  )
  .filter(Boolean);
const featuredBlogs = config.featured_blogs
  .map((slug) =>
    allBlogs.find((b) => b.id === slug && b.data.status === "published"),
  )
  .filter(Boolean);

const iconSvgs: Record<string, string> = {
  github: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>`,
  linkedin: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  twitter: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  mail: `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
};

const socials = [
  { href: config.github_link, label: "GitHub", icon: "github" },
  { href: config.linkedin_link, label: "LinkedIn", icon: "linkedin" },
  { href: config.twitter_link, label: "X", icon: "twitter" },
  { href: config.email_link, label: "Email", icon: "mail" },
];
---

<BaseLayout title={config.name} description={config.hero_tagline}>
  <div class="mx-auto max-w-[1100px] px-8 pt-12 pb-16">
    <!-- Hero -->
    <section class="grid items-center gap-12 py-12 md:grid-cols-[1.2fr_auto]">
      <div>
        <p
          class="text-text-secondary mb-4 text-[13px] font-bold tracking-[0.1em] uppercase"
        >
          {config.name}
        </p>
        <h1
          class="font-heading mb-4 text-[42px] leading-[1.1] font-bold tracking-[-0.04em]"
        >
          {config.hero_tagline}
        </h1>
        <p
          class="text-text-secondary mb-8 max-w-[480px] text-base leading-relaxed"
        >
          {config.hero_description}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/blog"
            class="btn-lift bg-accent-500 inline-flex items-center gap-1.5 rounded-md border-2 border-[#000] px-6 py-3 text-sm font-bold tracking-[-0.01em] shadow-md"
          >
            Read the blog
          </a>
          <a
            href="/projects"
            class="btn-lift inline-flex items-center gap-1.5 rounded-md border-2 border-[#000] bg-white px-6 py-3 text-sm font-bold tracking-[-0.01em] shadow-md"
          >
            See projects
          </a>
        </div>
        <div class="mt-6 flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="btn-lift grid h-11 w-11 place-items-center rounded-md border-2 border-[#000] bg-white shadow-sm"
              >
                <Fragment set:html={iconSvgs[s.icon]} />
              </a>
            ))
          }
        </div>
      </div>
      <div
        class="hidden h-[280px] w-[280px] place-items-center rounded-[14px] border-2 border-[#000] bg-white shadow-lg md:grid"
      >
        <span
          class="text-text-muted text-sm font-bold tracking-[0.1em] uppercase"
        >
          Photo
        </span>
      </div>
    </section>

    <hr class="my-10 border-t-2 border-[#000]" />

    <!-- 01 — Skills -->
    <section class="mb-10">
      <div class="mb-3">
        <span
          class="bg-sky font-heading inline-flex items-center rounded-md border-[1.5px] border-[#000] px-3 py-1 text-[11px] font-bold tracking-[0.08em] uppercase shadow-[0_2px_0_#000]"
        >
          01 — Skills
        </span>
      </div>
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <h2
          class="font-heading text-[28px] leading-[1.1] font-bold tracking-[-0.03em]"
        >
          Skills & tools
        </h2>
      </div>
      <div
        class="rounded-[14px] border-2 border-[#000] bg-[#FFD23F]/15 p-6 shadow-lg"
      >
        <p class="text-text-secondary mb-4 text-sm leading-relaxed">
          {config.skills_description}
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          {
            config.skills.map((category) => (
              <div>
                <h3 class="font-heading mb-1.5 text-base font-bold tracking-[-0.02em]">
                  {category.skill_title}
                </h3>
                <ul class="pl-5">
                  {category.entries.map((entry) => (
                    <li class="text-text-secondary mb-0.5 text-sm leading-relaxed [&::marker]:text-base [&::marker]:text-[#000]">
                      {entry}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="my-10 border-t-2 border-[#000]" />

    <!-- 02 — Blog -->
    {
      featuredBlogs.length > 0 && (
        <section class="mb-12">
          <div class="mb-3">
            <span class="bg-accent-500 font-heading inline-flex items-center rounded-md border-[1.5px] border-[#000] px-3 py-1 text-[11px] font-bold tracking-[0.08em] uppercase shadow-[0_2px_0_#000]">
              02 — Blog
            </span>
          </div>
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <h2 class="font-heading text-[28px] leading-[1.1] font-bold tracking-[-0.03em]">
              Latest writing
            </h2>
            <a
              href="/blog"
              class="border-b-2 border-[#000] pb-px text-[13px] font-bold transition-opacity hover:opacity-60"
            >
              All posts &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featuredBlogs.map((blog) => (
              <BlogCard
                title={blog!.data.title}
                description={blog!.data.description}
                publishDate={blog!.data.publish_date}
                readingTime={blog!.data.reading_time}
                tags={blog!.data.tags}
                href={`/blog/${blog!.id}`}
                slug={blog!.id}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      featuredBlogs.length > 0 && featuredProjects.length > 0 && (
        <hr class="my-10 border-t-2 border-[#000]" />
      )
    }

    <!-- 03 — Projects -->
    {
      featuredProjects.length > 0 && (
        <section>
          <div class="mb-3">
            <span class="bg-lavender font-heading inline-flex items-center rounded-md border-[1.5px] border-[#000] px-3 py-1 text-[11px] font-bold tracking-[0.08em] uppercase shadow-[0_2px_0_#000]">
              03 — Projects
            </span>
          </div>
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <h2 class="font-heading text-[28px] leading-[1.1] font-bold tracking-[-0.03em]">
              Things I've built
            </h2>
            <a
              href="/projects"
              class="border-b-2 border-[#000] pb-px text-[13px] font-bold transition-opacity hover:opacity-60"
            >
              All projects &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {featuredProjects.map((project) => (
              <a
                href={project!.data.github_link}
                target="_blank"
                rel="noopener noreferrer"
                class="card-lift block cursor-pointer overflow-hidden rounded-[14px] border-2 border-[#000] bg-white shadow-lg select-none"
              >
                <div
                  class="relative flex h-[160px] items-center justify-center"
                  style={`background: ${project!.data.background_color}`}
                >
                  <div
                    class="absolute inset-0"
                    style={`background: repeating-linear-gradient(45deg, ${project!.data.background_color} 0, ${project!.data.background_color} 18px, ${project!.data.background_color}cc 18px, ${project!.data.background_color}cc 36px)`}
                  />
                  <span
                    class="font-heading relative z-10 text-2xl font-bold"
                    style={`color: ${project!.data.foreground_color}`}
                  >
                    {project!.data.title}
                  </span>
                </div>
                <div class="p-4 pb-3.5">
                  <h3 class="font-heading mb-1.5 text-[17px] leading-snug font-bold tracking-tight">
                    {project!.data.title}
                  </h3>
                  <p class="text-text-secondary mb-3 text-[13px] leading-relaxed">
                    {project!.data.description}
                  </p>
                  <div class="flex flex-wrap gap-[5px]">
                    {project!.data.technologies.map((tech) => (
                      <span class="tag-lift bg-sky inline-flex items-center rounded-md border-[1.5px] border-[#000] px-2 py-0.5 text-[11px] font-bold shadow-[0_2px_0_#000]">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
