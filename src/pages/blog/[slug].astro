---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PageHeading } from "../../components/layout";
import { Arrow, Pill, RisoFigure, TagList } from "../../components/ui";
import { getBlogPosts, isLocalPost, toPostSummary } from "../../lib/content";
import { sectionIndex } from "../../lib/navigation";

/** Only posts hosted here get a page; the others link to where they were published. */
export const getStaticPaths = (async () => {
  const posts = (await getBlogPosts()).filter(isLocalPost);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content } = await render(post);
const summary = toPostSummary(post);

const banners = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);
const bannerKey = Object.keys(banners).find((key) =>
  key.startsWith(`/content/blogs/${post.id}/banner.`),
);
const banner = bannerKey ? banners[bannerKey].default.src : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  currentPage="blog"
  ogImage={banner}
  background={false}
>
  <!-- One centred reading column, heading included, so every block lines up -->
  <article class="max-w-article mx-auto flex w-full flex-col gap-12">
    <PageHeading
      id="post-h"
      index={sectionIndex("blog")}
      title={post.data.title}
      lead={post.data.description}
    >
      <div
        class="border-rule leading-label text-muted text-2xs flex flex-wrap items-center justify-between gap-4 border-t pt-4 font-mono"
      >
        <span>
          <time datetime={post.data.publish_date}>{summary.dateLabel}</time> · {
            summary.readingTime
          }
        </span>
        <TagList tags={post.data.tags} />
      </div>
    </PageHeading>
    <!-- Kept to the text column: figures redraw every frame, so their cost grows with their area -->
    <figure class="rounded-card border-rule bg-card p-frame w-full border">
      <RisoFigure
        figure={summary.artwork}
        label={summary.artworkAlt}
        className="rounded-art aspect-video w-full"
      />
    </figure>
    <div class="prose">
      <Content />
    </div>
    <!-- No rule above: footnotes bring their own, and the button stands on its own -->
    <footer>
      <Pill href="/blog">
        All articles <Arrow className="group-hover:translate-x-1" />
      </Pill>
    </footer>
  </article>
</BaseLayout>
