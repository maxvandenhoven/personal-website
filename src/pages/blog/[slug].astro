---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperSheet from "../../components/layout/PaperSheet.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blogs")).filter(
    (post) => post.data.status === "published",
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content } = await render(post);

const bannerKey = Object.keys(bannerImages).find((key) =>
  key.startsWith(`/content/blogs/${post.id}/banner.`),
);
const bannerSrc = bannerKey ? bannerImages[bannerKey].default.src : undefined;

function formatDate(dateStr: string): string {
  return new Date(dateStr + "T00:00:00").toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout
  title={`${post.data.title} — Max van den Hoven`}
  description={post.data.description}
>
  <!-- A plain white sheet: no rules behind long-form text, for legibility.
       pattern="none" also switches the baseline-grid nudges off. -->
  <PaperSheet
    variant="skills"
    pattern="none"
    layer={1}
    class="min-h-[calc(100vh-var(--nb-header-h))]"
  >
    <article class="mx-auto max-w-[850px]">
      <header class="mb-10">
        <p class="nb-mono-label mb-4">
          <time datetime={post.data.publish_date}>
            {formatDate(post.data.publish_date)}
          </time>
          &nbsp;&middot;&nbsp;
          {post.data.reading_time}
        </p>
        <h1 class="nb-h2">{post.data.title}</h1>
        <p class="nb-subtitle mt-3">{post.data.description}</p>
      </header>
      {
        bannerSrc && (
          <img
            src={bannerSrc}
            alt=""
            class="mb-10 w-full rounded-[2px] object-cover shadow-[var(--nb-shadow-small)]"
          />
        )
      }
      <div class="nb-prose">
        <Content />
      </div>
    </article>
  </PaperSheet>
</BaseLayout>
