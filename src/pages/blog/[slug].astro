---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PageHeading } from "../../components/layout";
import { Arrow, RisoFigure, TagList } from "../../components/ui";
import {
  getPublishedPosts,
  hasLocalPage,
  toPostSummary,
} from "../../lib/content";
import { sectionIndex } from "../../lib/navigation";

/** Posts that only live elsewhere (no Markdown body) get no page of their own. */
export const getStaticPaths = (async () => {
  const posts = (await getPublishedPosts()).filter(hasLocalPage);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content } = await render(post);
const summary = toPostSummary(post);
const { external } = post.data;

const banners = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);
const bannerKey = Object.keys(banners).find((key) =>
  key.startsWith(`/content/blogs/${post.id}/banner.`),
);
const banner = bannerKey ? banners[bannerKey].default.src : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  currentPage="blog"
  ogImage={banner}
  canonical={external?.url}
>
  <article class="flex flex-col gap-12">
    <PageHeading
      id="post-h"
      index={sectionIndex("blog")}
      title={post.data.title}
      lead={post.data.description}
    >
      <div
        class="border-rule leading-label text-muted text-2xs flex flex-wrap items-center justify-between gap-4 border-t pt-4 font-mono"
      >
        <span>
          <time datetime={post.data.updated_date ?? post.data.publish_date}
            >{summary.dateLabel}</time
          > · {summary.readingTime}
        </span>
        <TagList tags={post.data.tags} />
      </div>
    </PageHeading>
    <!-- Kept to the text column: figures are redrawn every frame, so their cost grows with their area -->
    <figure
      class="rounded-card border-rule bg-card p-frame mx-auto w-full max-w-prose border"
    >
      <RisoFigure
        figure={post.data.figure}
        label={post.data.figure_alt}
        className="rounded-art aspect-video w-full"
      />
    </figure>
    <div class="prose mx-auto w-full max-w-prose">
      <Content />
    </div>
    {
      external && (
        <p class="mx-auto w-full max-w-prose">
          <a
            href={external.url}
            class="group text-muted hover:text-ink font-mono text-xs"
          >
            Originally published on {external.site}{" "}
            <Arrow className="group-hover:translate-x-1" />
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>
