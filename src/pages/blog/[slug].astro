---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blogs")).filter(
    (post) => post.data.status === "published",
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props as Props;
const { Content } = await render(post);

const bannerKey = Object.keys(bannerImages).find((key) =>
  key.startsWith(`/content/blogs/${post.id}/banner.`),
);
const bannerSrc = bannerKey ? bannerImages[bannerKey].default.src : undefined;

function formatDate(dateStr: string): string {
  return new Date(dateStr + "T00:00:00").toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout
  title={`${post.data.title} — Max van den Hoven`}
  description={post.data.description}
>
  <article>
    <header class="mx-auto max-w-[1100px] px-8 pt-16 pb-10">
      <p class="text-text-secondary mb-4 text-sm">
        <time datetime={post.data.publish_date}>
          {formatDate(post.data.publish_date)}
        </time>
        &nbsp;&middot;&nbsp;
        {post.data.reading_time}
      </p>
      <h1
        class="font-heading mb-5 text-4xl leading-[1.1] font-bold tracking-[-0.03em]"
      >
        {post.data.title}
      </h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        {post.data.description}
      </p>
    </header>
    {
      bannerSrc && (
        <div class="mx-auto max-w-[850px] px-8 pb-10">
          <img
            src={bannerSrc}
            alt=""
            class="w-full rounded-[14px] border-2 border-[#000] object-cover"
          />
        </div>
      )
    }
    <div class="prose mx-auto max-w-[850px] px-8 pb-16">
      <Content />
    </div>
  </article>
</BaseLayout>
