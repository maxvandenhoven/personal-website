---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperSheet from "../../components/layout/PaperSheet.astro";
import SectionHeader from "../../components/layout/SectionHeader.astro";
import { BlogList } from "../../components/blog/BlogList";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/content/blogs/*/banner.{jpg,jpeg,png,webp}",
  { eager: true },
);

const posts = (await getCollection("blogs"))
  .filter((post) => post.data.status === "published")
  .sort(
    (a, b) =>
      new Date(b.data.publish_date).getTime() -
      new Date(a.data.publish_date).getTime(),
  );

const serializedPosts = posts.map((post) => {
  const bannerKey = Object.keys(bannerImages).find((key) =>
    key.startsWith(`/content/blogs/${post.id}/banner.`),
  );
  return {
    title: post.data.title,
    description: post.data.description,
    publishDate: post.data.publish_date,
    readingTime: post.data.reading_time,
    tags: post.data.tags,
    slug: post.id,
    bannerSrc: bannerKey ? bannerImages[bannerKey].default.src : undefined,
  };
});
---

<BaseLayout
  title="Blog — Max van den Hoven"
  description="Field notes on building software, exploring new technologies, and lessons learned along the way."
>
  <!-- One light-blue ruled sheet (the same paper as the homepage's blog
       section), stretched to at least the viewport so the page is all
       paper. Title/subtitle sit on the rules via SectionHeader. -->
  <PaperSheet
    variant="blog"
    pattern="ruled"
    margin
    layer={1}
    class="min-h-[calc(100vh-var(--nb-header-h))]"
  >
    <SectionHeader
      title="Read my writing"
      subtitle="Field notes on building software, exploring new technologies, and lessons learned along the way."
    />
    <BlogList client:load posts={serializedPosts} />
  </PaperSheet>
</BaseLayout>
