---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BlogCard } from "../../components/blog";
import { PageHeading } from "../../components/layout";
import { FilterableList } from "../../components/ui";
import { getPosts, getSiteConfig } from "../../lib/content";
import { collectTags } from "../../lib/tags";
import { sectionIndex } from "../../lib/navigation";

const site = await getSiteConfig();
const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description={site.blog_page.description}
  currentPage="blog"
>
  <PageHeading
    id="blog-h"
    index={sectionIndex("blog")}
    title="Blog"
    lead={site.blog_page.lead}
  />
  <FilterableList
    label="Browse articles"
    tags={collectTags(posts)}
    total={posts.length}
    noun={{ singular: "article", plural: "articles" }}
    emptyMessage="No articles match this topic."
  >
    {posts.map((post) => <BlogCard post={post} />)}
  </FilterableList>
</BaseLayout>
