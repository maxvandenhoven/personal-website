---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BlogList } from "../../components/blog";

const posts = (await getCollection("blogs"))
  .filter((post) => post.data.status === "published")
  .sort(
    (a, b) =>
      new Date(b.data.publish_date).getTime() -
      new Date(a.data.publish_date).getTime(),
  );

const serializedPosts = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  publishDate: post.data.publish_date,
  readingTime: post.data.reading_time,
  tags: post.data.tags,
  slug: post.id,
}));
---

<BaseLayout
  title="Blog — Max van den Hoven"
  description="Field notes on building software, exploring new technologies, and lessons learned along the way."
>
  <div class="mx-auto max-w-[1100px] px-8 pt-12 pb-4">
    <p
      class="text-text-secondary mb-4 text-[13px] font-bold tracking-[0.1em] uppercase"
    >
      Blog
    </p>
    <h1
      class="font-heading mb-4 text-[42px] leading-[1.1] font-bold tracking-[-0.04em]"
    >
      Read my writing
    </h1>
    <p class="text-text-secondary mb-2 max-w-[480px] text-base leading-relaxed">
      Field notes on building software, exploring new technologies, and lessons
      learned along the way.
    </p>
  </div>
  <BlogList client:load posts={serializedPosts} />
</BaseLayout>
