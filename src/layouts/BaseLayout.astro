---
import "../styles/global.css";
import { Footer, Header } from "../components/layout";
import { getSiteConfig } from "../lib/content";
import { cx } from "../lib/cx";
import type { NavPage } from "../lib/navigation";

interface Props {
  /** Page name, shown before the site name in the tab title; omit on the homepage. */
  title?: string;
  description: string;
  /** Highlighted in the navigation. */
  currentPage?: NavPage;
  /** Absolute or site-relative image for link previews. */
  ogImage?: string;
  /** Overrides the canonical URL, e.g. for articles first published elsewhere. */
  canonical?: string;
  /** Spacing between the top-level blocks of <main>. */
  spacing?: "sections" | "compact";
  /** Show the interactive dot-grid background; off for long-form reading. */
  background?: boolean;
}

const {
  title,
  description,
  currentPage,
  ogImage,
  canonical,
  spacing = "compact",
  background = true,
} = Astro.props;
const site = await getSiteConfig();
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Martian+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    {
      background && (
        <canvas
          data-riso-background
          aria-hidden="true"
          class="pointer-events-none fixed inset-0 z-0 size-full"
        />
      )
    }
    <div id="top" class="max-w-site relative z-1 mx-auto">
      <Header name={site.name} currentPage={currentPage} />
      <main
        class={cx(
          "flex flex-col pt-8 md:pt-12",
          spacing === "sections" ? "gap-section" : "gap-12",
        )}
      >
        <slot />
      </main>
    </div>
    <Footer
      name={site.name}
      email={site.email}
      socials={site.socials}
      contact={site.contact}
    />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
